[run]
# Coverage scope
#
# The 100% gate covers the shipped runtime package, `voice_reader/`. The thin
# `app.py` entrypoint is deliberately outside it: it wires the composition root
# to a real Qt application and a real audio device, so measuring it would only
# measure the wiring. It is therefore not named here at all, rather than being
# sourced and then omitted.
#
# IMPORTANT: Running `pytest --cov` with no target can cause pytest-cov to
# measure essentially all Python files under the repo root (including installer
# and build tooling), which is not the intended gate.
source =
    voice_reader

omit =
    # Non-runtime tooling, artifacts and data.
    */venv/*
    */.venv/*
    */__pycache__/*
    */.pytest_cache/*
    */htmlcov/*
    */.git/*
    */cache/*
    */temp_books/*
    # Data directory of real books at the repo root only. This must NOT be
    # `*/books/*`, which also matches `voice_reader/infrastructure/books/*`
    # and silently drops the shipped parser and structure modules from the gate.
    books/*
    */voices/*
    */tests/*
    installer/*
    buildexe.py
    buildinstaller.py
    generate_scripts.py
    NarrateX.spec
    NarrateXSetup.spec
    shibokensupport/*
    pyscript
    pyscript/*
    signature_bootstrap.py

    # Audio devices, TTS engines and the filesystem repositories that back
    # them. Each one talks to hardware or an external model at import or call
    # time, so it is exercised by integration rather than by the gate.
    voice_reader/infrastructure/tts/kokoro_engine.py
    voice_reader/infrastructure/tts/tts_engine_factory.py
    voice_reader/infrastructure/bookmarks/json_bookmark_repository.py
    voice_reader/infrastructure/audio/audio_streamer.py
    voice_reader/infrastructure/audio/sounddevice_streamer.py
    voice_reader/infrastructure/audio/_sounddevice_workers.py
    voice_reader/infrastructure/audio/_sounddevice_helpers.py
    voice_reader/infrastructure/audio/_silence_trimmer.py
    voice_reader/infrastructure/preferences/json_preferences_repository.py
    voice_reader/shared/resources.py

    # The Qt layer: windows, dialogs and the controllers that drive them.
    # These need an event loop and a live widget tree.
    voice_reader/ui/main_window.py
    voice_reader/ui/_main_window_build.py
    voice_reader/ui/_main_window_controls.py
    voice_reader/ui/window_helpers.py
    voice_reader/ui/_help_dialogs.py
    voice_reader/ui/licence_dialog.py
    voice_reader/ui/model_download_dialog.py
    voice_reader/ui/bookmarks_dialog.py
    voice_reader/ui/structural_bookmarks_dialog.py
    voice_reader/ui/_message_box_utils.py
    voice_reader/ui/ui_controller.py
    voice_reader/ui/_ui_controller_bookmarks.py
    voice_reader/ui/_ui_controller_chapters.py
    voice_reader/ui/_ui_controller_playback.py
    voice_reader/ui/_ui_controller_sections.py
    voice_reader/ui/_ui_controller_state.py

    # Ideas indexing and navigation: the Qt event loop plus background threads.
    voice_reader/ui/_ideas_navigation.py
    voice_reader/ui/_ui_controller_idea_indexing.py
    voice_reader/ui/_ui_controller_book_loading.py
    voice_reader/ui/_book_load_compute.py

    # Legacy Ideas UI (the brain button now uses Sections instead of Ideas).
    voice_reader/ui/_ui_controller_ideas.py
    voice_reader/ui/ideas_dialog.py

[report]
show_missing = True
skip_covered = False
fail_under = 100
